# =====================================================================
# MotionGraphic.si — Variables d'environnement
# Copiez ce fichier : cp .env.example .env.local
# =====================================================================

# --- Supabase (optionnel) --------------------------------------------
# Sans ces variables, le site démarre en MODE DÉMONSTRATION avec des
# données locales. Avec elles, les données passent en Supabase (RLS).
# Trouvez les valeurs : Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Serveur MCP (https://votre-domaine/api/mcp) ----------------------
# Token Bearer des assistants IA (Claude/ChatGPT) appelant /api/mcp.
# Générez-en un long et aléatoire ; côté MCP : user propriétaire des projets.
MCP_ACCESS_TOKEN=
MCP_USER_ID=

# --- Clé de service (NE JAMAIS l'exposer au navigateur) ---------------
# Clé serveur uniquement : utilisée (a) par le serveur MCP, (b) jamais dans
# le bundle navigateur. Laissez vide :
# l'application Next.js n'utilise JAMAIS cette clé dans le bundle client.
SUPABASE_SERVICE_ROLE_KEY=