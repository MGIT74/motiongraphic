# =====================================================================
# MotionGraphic.si — Variables d'environnement
# Copiez ce fichier : cp .env.example .env.local
# =====================================================================

# --- Supabase (optionnel) --------------------------------------------
# Sans ces variables, le site démarre en MODE DÉMONSTRATION avec des
# données locales. Avec elles, les données passent en Supabase (RLS).
# Trouvez les valeurs : Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Clé de service (NE JAMAIS l'exposer au navigateur) ---------------
# Ne sert qu'à des scripts d'administration côté serveur. Laissez vide :
# l'application Next.js n'utilise JAMAIS cette clé dans le bundle client.
SUPABASE_SERVICE_ROLE_KEY=